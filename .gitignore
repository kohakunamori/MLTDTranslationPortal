# 本地秘密、运行产物与数据 checkout 不得入库
.env
.env.*
.dev.vars
.dev.vars.*
*.local.json
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*-wal
*-shm
*-journal
node_modules/
private/
raw/
keys/
*.key
*.pem
*.p12
*.pfx
__pycache__/
*.pyc
